# ------------------------------------------------------------------
# .env.example
#
# 이 프로젝트는 API 키, 토큰, 비밀번호 등 비밀정보가 전혀 필요 없습니다.
# 아래 변수는 모두 "선택 사항"이며, Gradio 서버 동작을 바꾸고 싶을 때만 사용합니다.
#
# 주의: app.py는 .env 파일을 자동으로 읽지 않습니다. 값은 실행 전 셸에서 설정하세요.
#   Windows PowerShell :  $env:GRADIO_SERVER_PORT = "7860"
#   macOS / Linux      :  export GRADIO_SERVER_PORT=7860
# (실제 값을 넣은 .env 파일은 .gitignore로 업로드에서 제외됩니다.)
# ------------------------------------------------------------------

# 웹 서버 포트 (기본값 7860, 사용 중이면 자동으로 다음 포트 사용)
GRADIO_SERVER_PORT=

# 바인딩 주소 (기본값 127.0.0.1 = 내 PC에서만 접속)
# 같은 네트워크의 다른 기기에서 접속하려면 0.0.0.0 — 단, 웹캠은 localhost 또는 HTTPS에서만 동작
GRADIO_SERVER_NAME=

# Gradio가 업로드/결과 이미지를 임시 저장하는 폴더 (기본값: OS 임시 폴더 아래 gradio/)
GRADIO_TEMP_DIR=

# Ultralytics 설정 파일 저장 폴더 (기본값: 사용자 설정 폴더)
YOLO_CONFIG_DIR=
